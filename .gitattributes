* text=auto
*.py text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.cmd text eol=crlf
*.png binary
*.webp binary

# Preserve upstream CRLF context inside compatibility patches.
*.patch -text -whitespace
